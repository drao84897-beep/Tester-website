# ===================================================
# WebVerify AI — Configuration & Environment Settings
# ===================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=production
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (Defaults to local SQLite, MySQL can be set as: mysql+pymysql://user:password@host/dbname)
DATABASE_URI=sqlite:///webverify.db

# Scanner Configuration
SCAN_TIMEOUT=8
MAX_RESPONSE_SIZE_BYTES=3145728
MAX_CRAWL_PAGES=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36 WebVerifyAI/1.0

# Optional AI Analysis Provider (Works 100% without any AI API key using built-in rule-based engine)
# Supported options for AI_PROVIDER: "none", "gemini", "openai", "groq"
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
